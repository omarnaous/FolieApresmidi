# Security headers for static assets served by Workers Static Assets.
# (Responses produced by the Worker — the API, /media and the server-rendered
# product/collection/page documents — set their own.)

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/account/*
  X-Robots-Tag: noindex

/checkout
  X-Robots-Tag: noindex

# Vite stamps a hash of the contents into every one of these filenames, so a
# changed file is a different URL and an old one can never be served in its
# place. Keeping them is the one cache that cannot go stale — and without it
# every page load fetches the whole shop again.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
