# Local secrets for `wrangler dev`. Copy to .dev.vars (gitignored) and fill in.
# In staging/production set each with `wrangler secret put NAME --env <env>`.

# Mixed into every password hash (HMAC pepper). Long random string. Never change
# it after launch, or every password stops matching.
PASSWORD_PEPPER=

# Signs the guest cart cookie and cart-recovery links. Long random string.
COOKIE_SECRET=

# One-time token that unlocks /admin setup (creating the owner account) while
# no staff account exists.
SETUP_TOKEN=

# Resend API key. Leave empty locally: emails are logged and listed at
# GET /api/dev/mail instead of being sent.
RESEND_API_KEY=

# Amazon SES. With both keys set, every email goes through SES and Resend is
# not consulted; the region defaults to us-east-1. Leave empty locally.
#   wrangler secret put AWS_ACCESS_KEY_ID --env preview
#   wrangler secret put AWS_SECRET_ACCESS_KEY --env preview
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Brevo. With a key set, every email goes through Brevo and the others are
# not consulted. EMAIL_FROM must name a sender verified in Brevo.
#   wrangler secret put BREVO_API_KEY --env preview
BREVO_API_KEY=
